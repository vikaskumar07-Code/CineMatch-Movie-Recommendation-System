```gitignore
# Virtual Environments
venv/
env/
.venv/

# Python Cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Environment Variables
.env

# Streamlit Secrets
.streamlit/secrets.toml

# VS Code
.vscode/

# Jupyter Notebook Cache
.ipynb_checkpoints/

# OS Files
.DS_Store
Thumbs.db

# Logs
*.log

# Cache Files
.cache/

# Temporary Files
*.tmp
*.temp
```
